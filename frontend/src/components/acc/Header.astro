---
import Icon from "@/assets/acc/icon.svg";
import { useTranslations } from "@/utils/i18n";
import MainHeader from "../app/MainHeader.astro";
import MainMobileNav from "../app/MainMobileNav.astro";
import NavLink from "../app/NavLink.astro";
import ThemeToggleButton from "../app/ThemeToggleButton.astro";
import MobileNavLink from "../app/MobileNavLink.astro";

const { lang } = Astro.params;
const t = useTranslations(lang as never);
---

<MainHeader>
    <a
        class="cursor-pointer flex gap-2 items-center font-bold text-acc-foreground"
        href="/acc"
    >
        <img
            src={Icon.src}
            alt={t("ACC.utils.icon.alt")}
            width={Icon.width}
            height={Icon.height}
            class="size-10 aspect-square w-10 h-10 rounded-full"
            loading="eager"
        />
        <span class="hidden sm:block font-heading">
            The Americas Chambers of Commerce
        </span>
    </a>

    <nav class="hidden lg:flex items-center gap-2">
        <NavLink href="/">
            {t("ACC.header.nav.home")}
        </NavLink>

        <NavLink href="/acc" variant="acc">
            {t("ACC.header.nav.ACC")}
        </NavLink>

        <NavLink href="/acc/about" variant="acc">
            {t("ACC.header.nav.about")}
        </NavLink>

        <NavLink href="/acc/programs" variant="acc">
            {t("ACC.header.nav.programs")}
        </NavLink>

        <NavLink href="/acc/events" variant="acc">
            {t("ACC.header.nav.events")}
        </NavLink>

        <NavLink href="/contact">
            {t("ACC.header.nav.contact")}
        </NavLink>
    </nav>

    <nav class="flex gap-2">
        <MainMobileNav >
            <MobileNavLink href="/">
                {t("ACC.header.nav.home")}
            </MobileNavLink>

            <MobileNavLink href="/acc" variant="acc">
                {t("ACC.header.nav.ACC")}
            </MobileNavLink>

            <MobileNavLink href="/acc/about" variant="acc">
                {t("ACC.header.nav.about")}
            </MobileNavLink>

            <MobileNavLink href="/acc/programs" variant="acc">
                {t("ACC.header.nav.programs")}
            </MobileNavLink>

            <MobileNavLink href="/acc/events" variant="acc">
                {t("ACC.header.nav.events")}
            </MobileNavLink>

            <MobileNavLink href="/contact">
                {t("ACC.header.nav.contact")}
            </MobileNavLink>
        </MainMobileNav>

        <ThemeToggleButton />
    </nav>
</MainHeader>
