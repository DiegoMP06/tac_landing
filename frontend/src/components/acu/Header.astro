---
import Icon from "@/assets/acu/icon.svg";
import { useTranslations } from "@/utils/i18n";
import MainHeader from "../app/MainHeader.astro";
import MainMobileNav from "../app/MainMobileNav.astro";
import NavLink from "../app/NavLink.astro";
import ThemeToggleButton from "../app/ThemeToggleButton.astro";
import MobileNavLink from "../app/MobileNavLink.astro";

const { lang } = Astro.params;
const t = useTranslations(lang as never);
---

<MainHeader>
    <a
        class="cursor-pointer flex gap-2 items-center font-bold text-acu-foreground"
        href="/acu"
    >
        <img
            src={Icon.src}
            alt={t("ACU.utils.icon.alt")}
            width={Icon.width}
            height={Icon.height}
            class="size-10 aspect-square w-10 h-10 rounded-full"
            loading="eager"
        />
        <span class="hidden sm:block font-heading">
            The Americas Conference of Universities
        </span>
    </a>

    <nav class="hidden lg:flex items-center gap-2">
        <NavLink href="/">
            {t("ACU.header.nav.home")}
        </NavLink>

        <NavLink href="/acu" variant="acu">
            {t("ACU.header.nav.ACU")}
        </NavLink>

        <NavLink href="/acu/about" variant="acu">
            {t("ACU.header.nav.about")}
        </NavLink>

        <NavLink href="/acu/programs" variant="acu">
            {t("ACU.header.nav.programs")}
        </NavLink>

        <NavLink href="/acu/events" variant="acu">
            {t("ACU.header.nav.events")}
        </NavLink>

        <NavLink href="/blog">
            {t("ACU.header.nav.blog")}
        </NavLink>

        <NavLink href="/contact">
            {t("ACU.header.nav.contact")}
        </NavLink>
    </nav>

    <nav class="flex gap-2">
        <MainMobileNav>
            <MobileNavLink href="/">
                {t("ACU.header.nav.home")}
            </MobileNavLink>

            <MobileNavLink href="/acu" variant="acu">
                {t("ACU.header.nav.ACU")}
            </MobileNavLink>

            <MobileNavLink href="/acu/about" variant="acu">
                {t("ACU.header.nav.about")}
            </MobileNavLink>

            <MobileNavLink href="/acu/programs" variant="acu">
                {t("ACU.header.nav.programs")}
            </MobileNavLink>

            <MobileNavLink href="/acu/events" variant="acu">
                {t("ACU.header.nav.events")}
            </MobileNavLink>

            <MobileNavLink href="/blog">
                {t("ACU.header.nav.blog")}
            </MobileNavLink>

            <MobileNavLink href="/contact">
                {t("ACU.header.nav.contact")}
            </MobileNavLink>
        </MainMobileNav>

        <ThemeToggleButton />
    </nav>
</MainHeader>
