---
import { BrandsEnum } from "@/enums";
import type { Brand } from "@/types";

type Props = {
    variant?: Brand;
};

const { variant = BrandsEnum.DEFAULT } = Astro.props;

const brandSvgMap: Record<Brand, string> = {
    [BrandsEnum.DEFAULT]: "/favicon.svg",
    [BrandsEnum.ACC]: "/acc.svg",
    [BrandsEnum.ACM]: "/acm.svg",
    [BrandsEnum.ACU]: "/acu.svg",
};

const primarySvg = brandSvgMap[variant] ?? "/favicon.svg";
---

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href={primarySvg} type="image/svg+xml" />
<link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
