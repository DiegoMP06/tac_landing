---
import { Menu, X } from "lucide-react";
import { useLocalePath, useTranslations } from "@/utils/i18n";

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);
---

<div x-data="navMobileToggle" class="block lg:hidden">
    <button
        type="button"
        @click="toggle"
        class="group p-2.5 rounded-xl cursor-pointer bg-background border border-border shadow-sm hover:shadow-md hover:bg-muted transition-all ease-out duration-300"
    >
        <Menu
            className="size-6 text-foreground group-hover:scale-110 transition-transform duration-300"
        />
    </button>

    <template x-teleport="body">
        <div
            x-show="isOpen"
            x-cloak
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 z-50 bg-black/60 flex justify-end backdrop-blur-md"
        >
            <div class="flex-1 cursor-pointer" @click="toggle"></div>

            <nav
                x-show="isOpen"
                x-transition:enter="transition ease-out duration-300 transform"
                x-transition:enter-start="translate-x-full"
                x-transition:enter-end="translate-x-0"
                x-transition:leave="transition ease-in duration-200 transform"
                x-transition:leave-start="translate-x-0"
                x-transition:leave-end="translate-x-full"
                class="bg-background max-w-80 w-full h-full flex flex-col shadow-2xl border-l border-border relative overflow-hidden"
            >
                <div
                    class="flex items-center justify-between p-6 border-b border-border bg-muted"
                >
                    <p
                        class="text-foreground font-heading font-bold text-2xl tracking-tight"
                    >
                        {t("AC.header.menu")}
                    </p>
                    <button
                        @click="toggle"
                        class="p-2 rounded-full cursor-pointer hover:bg-background text-muted-foreground hover:text-foreground transition-all duration-300 hover:scale-110"
                    >
                        <X className="size-6" />
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto p-6 scroll-smooth">
                    <nav
                        class="flex flex-col gap-2"
                        @click="if ($event.target.tagName === 'A' || $event.target.closest('a')) toggle()"
                    >
                        <slot />
                    </nav>
                </div>
            </nav>
        </div>
    </template>
</div>

<style is:global>
    [x-cloak] {
        display: none !important;
    }
</style>
