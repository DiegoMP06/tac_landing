---
import type { ContactPage } from "@/types/pages";
import ContactCard from "./ContactCard.astro";
import { BrandsEnum } from "@/enums";
import SectionHeading from "../SectionHeading.astro";
import SectionSubHeading from "../SectionSubHeading.astro";

type Props = {
    contact: ContactPage["acf"]["contact"];
};

const { contact } = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-6 py-20 md:py-28 relative overflow-hidden">
    <!-- Ambient glowing light orbs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 size-96 sm:size-125 bg-primary/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
    <div class="absolute bottom-10 right-1/4 size-80 sm:size-96 bg-secondary/15 rounded-full blur-3xl pointer-events-none animate-pulse-glow delay-300"></div>

    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24 scroll-reveal">
        <SectionHeading variant="default" className="text-center">
            {contact.title}
        </SectionHeading>

        <SectionSubHeading variant="default" className="text-center mt-3 mb-0">
            {contact.subtitle}
        </SectionSubHeading>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-10 items-stretch">
        <div class="lg:translate-y-8 scroll-reveal delay-100 h-full">
            <ContactCard item={contact.acm} variant={BrandsEnum.ACM} />
        </div>
        <div class="lg:-translate-y-4 scroll-reveal delay-200 h-full">
            <ContactCard item={contact.acc} variant={BrandsEnum.ACC} />
        </div>
        <div class="lg:translate-y-8 scroll-reveal delay-300 h-full">
            <ContactCard item={contact.acu} variant={BrandsEnum.ACU} />
        </div>
    </div>
</section>
