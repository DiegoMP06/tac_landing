---
import type { ContactPage } from "@/types/pages";
import ContactCard from "./ContactCard.astro";
import { BrandsEnum } from "@/enums";

type Props = {
    contact: ContactPage["acf"]["contact"];
};

const { contact } = Astro.props;
---

<section class="w-full max-w-7xl mx-auto px-6 py-20 md:py-28 relative overflow-hidden">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 size-96 bg-primary/10 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>

    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24 scroll-reveal">
        <h2 class="text-xs sm:text-sm font-primary tracking-widest uppercase font-bold text-muted-foreground mb-4 inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-muted/60 border border-border/50">
            <span class="size-2 rounded-full bg-primary animate-pulse"></span>
            {contact.title}
        </h2>
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-heading font-extrabold tracking-tight text-foreground leading-[1.1]">
            {contact.subtitle}
        </h3>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-10">
        <div class="lg:translate-y-8 scroll-reveal delay-100">
            <ContactCard item={contact.acm} variant={BrandsEnum.ACM} />
        </div>
        <div class="lg:-translate-y-4 scroll-reveal delay-200">
            <ContactCard item={contact.acc} variant={BrandsEnum.ACC} />
        </div>
        <div class="lg:translate-y-8 scroll-reveal delay-300">
            <ContactCard item={contact.acu} variant={BrandsEnum.ACU} />
        </div>
    </div>
</section>
