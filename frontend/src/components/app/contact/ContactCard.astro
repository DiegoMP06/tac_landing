---
import type { Brand } from "@/types";
import { MapPin, Phone, Mail, Clock } from "lucide-react";
import { cn } from "@/lib/utils";
import type { ContactItem } from "@/types/pages";

type Props = {
    item: ContactItem;
    variant: Brand;
};

const { item, variant } = Astro.props;

const STYLES = {
    acu: {
        card: "border-acu-border/70 hover:border-acu-secondary/80 hover:shadow-acu-secondary/15 before:bg-acu-secondary",
        badge: "bg-acu-secondary/15 text-acu-secondary border-acu-secondary/30",
        title: "text-foreground group-hover:text-acu-secondary",
        icon: "text-acu-secondary bg-acu-secondary/15 border-acu-secondary/30",
        link: "text-foreground hover:text-acu-secondary font-semibold",
        glow: "from-acu-secondary/10 via-transparent to-transparent",
        acronym: "ACU",
    },
    acc: {
        card: "border-acc-border/70 hover:border-acc-secondary/80 hover:shadow-acc-secondary/15 before:bg-acc-secondary",
        badge: "bg-acc-secondary/15 text-acc-secondary border-acc-secondary/30",
        title: "text-foreground group-hover:text-acc-secondary",
        icon: "text-acc-secondary bg-acc-secondary/15 border-acc-secondary/30",
        link: "text-foreground hover:text-acc-secondary font-semibold",
        glow: "from-acc-secondary/10 via-transparent to-transparent",
        acronym: "ACC",
    },
    acm: {
        card: "border-acm-border/70 hover:border-acm-secondary/80 hover:shadow-acm-secondary/15 before:bg-acm-secondary",
        badge: "bg-acm-secondary/15 text-acm-secondary border-acm-secondary/30",
        title: "text-foreground group-hover:text-acm-secondary",
        icon: "text-acm-secondary bg-acm-secondary/15 border-acm-secondary/30",
        link: "text-foreground hover:text-acm-secondary font-semibold",
        glow: "from-acm-secondary/10 via-transparent to-transparent",
        acronym: "ACM",
    },
    default: {
        card: "border-border/80 hover:border-secondary/80 hover:shadow-secondary/15 before:bg-secondary",
        badge: "bg-secondary/15 text-secondary border-secondary/30",
        title: "text-foreground group-hover:text-secondary",
        icon: "text-secondary bg-secondary/15 border-secondary/30",
        link: "text-foreground hover:text-secondary font-semibold",
        glow: "from-secondary/10 via-transparent to-transparent",
        acronym: "AC",
    },
};

const currentStyles = STYLES[variant] || STYLES.default;
---

<div
    class={cn(
        "group relative rounded-3xl border p-8 sm:p-9 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 flex flex-col justify-between h-full bg-card/85 dark:bg-card/50 backdrop-blur-xl overflow-hidden shadow-xs before:content-[''] before:absolute before:h-1 before:top-0 before:inset-x-0 before:transition-all before:duration-300 group-hover:before:h-1.5",
        currentStyles.card,
    )}
>
    <!-- Hover gradient glow -->
    <div
        class={cn(
            "absolute inset-0 bg-linear-to-br opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none",
            currentStyles.glow,
        )}
    >
    </div>

    <div class="relative z-10 flex-1 flex flex-col">
        <!-- Division badge -->
        <div class="mb-4">
            <span
                class={cn(
                    "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest border shadow-xs",
                    currentStyles.badge,
                )}
            >
                <span class="size-1.5 rounded-full bg-current"></span>
                {currentStyles.acronym}
            </span>
        </div>

        <h3
            class={cn(
                "text-2xl sm:text-3xl font-heading font-extrabold tracking-tight leading-snug mb-4 transition-colors duration-300",
                currentStyles.title,
            )}
        >
            {item.title}
        </h3>

        <div
            class="prose prose-sm dark:prose-invert text-muted-foreground leading-relaxed font-normal mb-8"
            set:html={item.content}
        />

        <div class="space-y-3 mt-auto pt-4 border-t border-border/60">
            {item.address && (
                <div
                    class="flex items-start gap-3.5 p-2.5 rounded-2xl hover:bg-muted/50 transition-colors"
                >
                    <div
                        class={cn(
                            "p-2.5 rounded-xl border shadow-xs shrink-0 group-hover:scale-105 transition-transform duration-300",
                            currentStyles.icon,
                        )}
                    >
                        <MapPin className="size-4.5" />
                    </div>
                    <p class="text-sm font-medium text-muted-foreground leading-relaxed flex-1 pt-1">{item.address}</p>
                </div>
            )}

            {item.number_phone && (
                <div
                    class="flex items-center gap-3.5 p-2.5 rounded-2xl hover:bg-muted/50 transition-colors"
                >
                    <div
                        class={cn(
                            "p-2.5 rounded-xl border shadow-xs shrink-0 group-hover:scale-105 transition-transform duration-300",
                            currentStyles.icon,
                        )}
                    >
                        <Phone className="size-4.5" />
                    </div>
                    <a
                        href={`tel:${item.number_phone.replace(/[^0-9+]/g, "")}`}
                        class={cn("text-sm flex-1 hover:underline focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring rounded-xs", currentStyles.link)}
                    >
                        {item.number_phone}
                    </a>
                </div>
            )}

            {item.email && (
                <div
                    class="flex items-center gap-3.5 p-2.5 rounded-2xl hover:bg-muted/50 transition-colors"
                >
                    <div
                        class={cn(
                            "p-2.5 rounded-xl border shadow-xs shrink-0 group-hover:scale-105 transition-transform duration-300",
                            currentStyles.icon,
                        )}
                    >
                        <Mail className="size-4.5" />
                    </div>
                    <a
                        href={`mailto:${item.email}`}
                        class={cn("text-sm flex-1 break-all hover:underline focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring rounded-xs", currentStyles.link)}
                    >
                        {item.email}
                    </a>
                </div>
            )}

            {item.schedule && (
                <div
                    class="flex items-center gap-3.5 p-2.5 rounded-2xl hover:bg-muted/50 transition-colors"
                >
                    <div
                        class={cn(
                            "p-2.5 rounded-xl border shadow-xs shrink-0 group-hover:scale-105 transition-transform duration-300",
                            currentStyles.icon,
                        )}
                    >
                        <Clock className="size-4.5" />
                    </div>
                    <p class="text-sm font-medium text-muted-foreground flex-1">{item.schedule}</p>
                </div>
            )}
        </div>
    </div>
</div>
