---
import type { Brand } from "@/types";
import { MapPin, Phone, Mail, Clock } from "lucide-react";
import { cn } from "@/lib/utils";
import type { ContactItem } from "@/types/pages";

type Props = {
    item: ContactItem;
    variant: Brand;
};

const { item, variant } = Astro.props;

const STYLES = {
    acu: {
        card: "border-acu-border/40 hover:border-acu-secondary/80 bg-acu-background/5",
        title: "text-acu-primary font-extrabold",
        icon: "text-acu-primary bg-acu-primary/15 border-acu-secondary/30",
        link: "text-acu-primary hover:text-acu-secondary/80 hover:underline font-semibold",
    },
    acc: {
        card: "border-acc-border/40 hover:border-acc-secondary/80 bg-acc-background/5",
        title: "text-acc-primary font-extrabold",
        icon: "text-acc-primary bg-acc-primary/15 border-acc-secondary/30",
        link: "text-acc-primary hover:text-acc-secondary/80 hover:underline font-semibold",
    },
    acm: {
        card: "border-acm-border/40 hover:border-acm-secondary/80 bg-acm-background/5",
        title: "text-acm-primary font-extrabold",
        icon: "text-acm-primary bg-acm-primary/15 border-acm-secondary/30",
        link: "text-acm-primary hover:text-acm-secondary/80 hover:underline font-semibold",
    },
    default: {
        card: "border-border/40 hover:border-secondary/80 bg-background/5",
        title: "text-secondary font-extrabold",
        icon: "text-secondary bg-primary/15 border-secondary/30",
        link: "text-secondary hover:text-secondary/80 hover:underline font-semibold",
    },
};

const currentStyles = STYLES[variant] || STYLES.default;
---

<div
    class={cn(
        "group relative rounded-3xl border p-8 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 flex flex-col h-full bg-card/70 backdrop-blur-md overflow-hidden",
        currentStyles.card,
    )}
>
    <div
        class="absolute inset-0 bg-linear-to-b from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    >
    </div>

    <h4
        class={cn(
            "text-2xl font-bold font-heading mb-4 transition-colors group-hover:translate-x-0.5 duration-300",
            currentStyles.title,
        )}
    >
        {item.title}
    </h4>

    <div
        class="prose prose-sm dark:prose-invert mb-8 opacity-80 leading-relaxed font-normal"
        set:html={item.content}
    />

    <div class="space-y-4 mt-auto relative z-10">
        <div
            class="flex items-center gap-4 p-2 rounded-xl hover:bg-muted/50 transition-colors"
        >
            <div
                class={cn(
                    "p-2.5 rounded-xl border shadow-sm group-hover:scale-110 transition-transform duration-300",
                    currentStyles.icon,
                )}
            >
                <MapPin className="w-5 h-5" />
            </div>
            <p class="text-sm opacity-90 font-medium flex-1">{item.address}</p>
        </div>

        <div
            class="flex items-center gap-4 p-2 rounded-xl hover:bg-muted/50 transition-colors"
        >
            <div
                class={cn(
                    "p-2.5 rounded-xl border shadow-sm group-hover:scale-110 transition-transform duration-300",
                    currentStyles.icon,
                )}
            >
                <Phone className="w-5 h-5" />
            </div>
            <a
                href={`tel:${item.number_phone.replace(/[^0-9+]/g, "")}`}
                class={cn("text-sm flex-1", currentStyles.link)}
                >{item.number_phone}</a
            >
        </div>

        <div
            class="flex items-center gap-4 p-2 rounded-xl hover:bg-muted/50 transition-colors"
        >
            <div
                class={cn(
                    "p-2.5 rounded-xl border shadow-sm group-hover:scale-110 transition-transform duration-300",
                    currentStyles.icon,
                )}
            >
                <Mail className="w-5 h-5" />
            </div>
            <a
                href={`mailto:${item.email}`}
                class={cn("text-sm flex-1 break-all", currentStyles.link)}
                >{item.email}</a
            >
        </div>

        <div
            class="flex items-center gap-4 p-2 rounded-xl hover:bg-muted/50 transition-colors"
        >
            <div
                class={cn(
                    "p-2.5 rounded-xl border shadow-sm group-hover:scale-110 transition-transform duration-300",
                    currentStyles.icon,
                )}
            >
                <Clock className="w-5 h-5" />
            </div>
            <p class="text-sm opacity-90 font-medium flex-1">{item.schedule}</p>
        </div>
    </div>
</div>
