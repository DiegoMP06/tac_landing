---
import MissionAndVisionCard from "./MissionAndVisionCard.astro";
import SectionHeading from "../SectionHeading.astro";
import type { Brand } from "@/types";
import SectionSubHeading from "../SectionSubHeading.astro";
import { cn } from "@/lib/utils";
import type { AboutPage } from "@/types/pages";
import { Compass, Target } from "lucide-react";

type Props = {
    section: AboutPage["acf"]["mission_and_vision"];
    variant?: Brand;
};

const styles = {
    acu: {
        container: "bg-acu-background/50 dark:bg-acu-background/25 border-y border-acu-border/60",
        orb1: "bg-acu-primary/10",
        orb2: "bg-acu-secondary/15",
    },
    acm: {
        container: "bg-acm-background/50 dark:bg-acm-background/25 border-y border-acm-border/60",
        orb1: "bg-acm-primary/10",
        orb2: "bg-acm-secondary/15",
    },
    acc: {
        container: "bg-acc-background/50 dark:bg-acc-background/25 border-y border-acc-border/60",
        orb1: "bg-acc-primary/10",
        orb2: "bg-acc-secondary/15",
    },
    default: {
        container: "bg-muted/40 border-y border-border/60",
        orb1: "bg-primary/10",
        orb2: "bg-secondary/15",
    },
};

const { section, variant = "default" } = Astro.props;
const currentStyles = styles[variant] || styles.default;
---

<section
    class={cn(
        "py-20 md:py-28 scroll-reveal relative overflow-hidden",
        currentStyles.container,
    )}
>
    <!-- Ambient glowing light orbs -->
    <div
        class={cn(
            "absolute top-1/2 left-1/4 -translate-y-1/2 size-96 sm:size-125 rounded-full blur-3xl pointer-events-none animate-pulse-glow",
            currentStyles.orb1,
        )}
    >
    </div>
    <div
        class={cn(
            "absolute bottom-10 right-1/4 size-80 sm:size-96 rounded-full blur-3xl pointer-events-none animate-pulse-glow delay-300",
            currentStyles.orb2,
        )}
    >
    </div>

    <div
        class="px-6 mx-auto max-w-6xl w-full flex flex-col items-center relative z-10"
    >
        <div class="scroll-reveal text-center max-w-3xl">
            <SectionHeading
                variant={variant}
                className="text-center"
            >
                {section.title}
            </SectionHeading>

            <SectionSubHeading
                variant={variant}
                className="text-center mt-3 mb-12 sm:mb-16"
            >
                {section.subtitle}
            </SectionSubHeading>
        </div>

        <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 w-full items-stretch"
        >
            <div class="scroll-reveal-left delay-100 h-full">
                <MissionAndVisionCard card={section.mission} variant={variant}>
                    <Target />
                </MissionAndVisionCard>
            </div>

            <div class="scroll-reveal-right delay-200 h-full">
                <MissionAndVisionCard card={section.vision} variant={variant}>
                    <Compass />
                </MissionAndVisionCard>
            </div>
        </div>
    </div>
</section>
