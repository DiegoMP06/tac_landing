---
import type { AboutPage } from "@/types/pages";
import WhatWeDoCard from "./WhatWeDoCard.astro";
import type { Brand } from "@/types";
import SectionHeading from "../SectionHeading.astro";
import SectionSubHeading from "../SectionSubHeading.astro";
import { cn } from "@/lib/utils";

type Props = {
    variant?: Brand;
    section: AboutPage["acf"]["what_we_do"];
};

const delays = [
    "delay-100",
    "delay-200",
    "delay-300",
    "delay-400",
    "delay-500",
    "delay-600",
];

const { section, variant = "default" } = Astro.props;
---

<section class="py-20 md:py-28 scroll-reveal bg-background">
    <div class="px-6 max-w-6xl w-full mx-auto">
        <div class="max-w-3xl mb-12 sm:mb-16 scroll-reveal">
            <SectionHeading variant={variant}>
                {section.title}
            </SectionHeading>

            <SectionSubHeading variant={variant} className="mt-3 mb-0">
                {section.subtitle}
            </SectionSubHeading>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
            {
                section.cards.map((card, index) => (
                    <div
                        class={`h-full scroll-reveal ${delays[index] || "delay-500"}`}
                    >
                        <WhatWeDoCard
                            card={card}
                            index={index + 1}
                            total={section.cards.length}
                            variant={variant}
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
