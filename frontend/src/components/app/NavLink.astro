---
import { cn } from "@/lib/utils";
import { useLocalePath } from "@/utils/i18n";

type Props = {
    variant?: "ac" | "acu" | "acm" | "acc";
    href: string;
} & astroHTML.JSX.AnchorHTMLAttributes;

const classes = {
    ac: "hover:bg-muted/80 hover:text-secondary",
    acu: "hover:bg-acu-muted/80 hover:text-acu-secondary font-semibold",
    acm: "hover:bg-acm-muted/80 hover:text-acm-secondary font-semibold",
    acc: "hover:bg-acc-muted/80 hover:text-acc-secondary font-semibold",
};

const { class: className, variant = "ac", href, ...props } = Astro.props;

const variantClasses = classes[variant];

const { localePath } = useLocalePath(Astro.url);
---

<a
    class={cn(
        "text-sm font-medium transition-all px-3.5 py-2 rounded-xl duration-300 ease-in-out text-muted-foreground hover:scale-[1.02]",
        variantClasses,
        className,
    )}
    href={localePath(href)}
    {...props}
>
    <slot />
</a>
