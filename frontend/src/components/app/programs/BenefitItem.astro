---
import type { Benefit } from "@/types/programs";

type Props = {
    benefit: Benefit;
};

const { benefit } = Astro.props;
---

<div class="group p-6 rounded-2xl border border-border/80 bg-card/80 backdrop-blur-sm shadow-sm hover:shadow-xl hover:border-secondary/60 hover:-translate-y-1 transition-all duration-300 flex flex-col gap-3">
    <div class="flex items-center gap-3">
        <div class="size-10 rounded-xl bg-secondary/15 text-secondary border border-secondary/30 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform duration-300">
            <span
                class="size-5 block [&>svg]:h-full [&>svg]:w-full"
                set:html={benefit.icon}
            />
        </div>
        <h4 class="font-heading font-bold text-base text-foreground leading-snug group-hover:text-secondary transition-colors">{benefit.title}</h4>
    </div>

    <p class="text-muted-foreground text-sm leading-relaxed font-normal">
        {benefit.description}
    </p>
</div>
