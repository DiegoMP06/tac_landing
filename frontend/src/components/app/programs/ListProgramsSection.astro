---
import type { Brand } from "@/types";
import ListProgramsContainer from "./ListProgramsContainer.astro";

type Props = {
    variant?: Brand;
};

const { variant = "default" } = Astro.props;
---

<section class="px-6 my-16 sm:my-20 md:my-24 max-w-6xl w-full mx-auto">
    <ListProgramsContainer variant={variant} />
</section>
