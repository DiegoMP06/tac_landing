---
import type { Speaker } from "@/types/events";
import type { FeaturedImageAtt } from "@/types/images";
import { useFeaturedImage } from "@/utils/image";
import { Picture } from "astro:assets";
import { Link, User } from "lucide-react";

type Props = {
    speaker: Speaker;
};

const { speaker } = Astro.props;
const image = useFeaturedImage(speaker.photo)("thumbnail") as FeaturedImageAtt;
---

<div
    class="group relative p-5 rounded-2xl border border-border/80 bg-card/80 backdrop-blur-sm shadow-sm hover:shadow-xl hover:border-secondary/60 hover:-translate-y-1 transition-all duration-300 flex items-start gap-4 overflow-hidden"
>
    <div
        class="absolute inset-0 bg-linear-to-r from-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    >
    </div>

    <div
        class="relative size-16 rounded-2xl p-0.5 bg-linear-to-br from-secondary/40 via-border to-secondary/10 shrink-0 shadow-md"
    >
        <div
            class="w-full h-full rounded-[14px] overflow-hidden bg-muted flex items-center justify-center"
        >
            {
                image ? (
                    <Picture
                        src={image.url}
                        alt={speaker.name}
                        width={image.width}
                        height={image.height}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                ) : (
                    <User className="size-8 text-muted-foreground" />
                )
            }
        </div>
    </div>

    <div class="flex-1 min-w-0 space-y-1 relative z-10">
        <h4
            class="font-heading font-bold text-base text-foreground leading-snug truncate group-hover:text-secondary transition-colors"
        >
            {speaker.name}
        </h4>

        {
            speaker.position && (
                <p class="text-xs font-semibold text-muted-foreground line-clamp-1">
                    {speaker.position}
                </p>
            )
        }

        {
            speaker.organization && (
                <div class="pt-0.5">
                    <span class="inline-block px-2 py-0.5 text-[11px] font-medium bg-muted text-muted-foreground rounded-md border border-border/50 truncate max-w-full">
                        {speaker.organization}
                    </span>
                </div>
            )
        }

        {
            speaker.linkedin && (
                <div class="pt-1.5">
                    <a
                        href={speaker.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-bold text-secondary bg-secondary/15 hover:bg-secondary hover:text-secondary-foreground rounded-lg transition-all duration-200 border border-secondary/30"
                    >
                        <Link className="size-3.5" />
                        <span>LinkedIn</span>
                    </a>
                </div>
            )
        }
    </div>
</div>
