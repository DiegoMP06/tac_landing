---
import OurImpactCard from "./OurImpactCard.astro";
import SectionHeading from "../SectionHeading.astro";
import SectionSubHeading from "../SectionSubHeading.astro";
import type { HomePage } from "@/types/pages";
import type { Brand } from "@/types";

type Props = {
    section: HomePage["acf"]["impact"];
    variant?: Brand;
};

const delays = ["delay-100", "delay-200", "delay-300"];

const { section, variant = "default" } = Astro.props;
---

<section class="my-20 md:my-28 max-w-6xl mx-auto w-full px-6 scroll-reveal">
    <div class="scroll-reveal mb-10 sm:mb-12">
        <SectionHeading variant={variant}>
            {section.title}
        </SectionHeading>

        <SectionSubHeading variant={variant} className="mt-2 mb-0">
            {section.subtitle}
        </SectionSubHeading>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        {
            section.cards.map((card, index) => (
                <div class={`h-full scroll-reveal ${delays[index] || "delay-300"}`}>
                    <OurImpactCard variant={variant} card={card} />
                </div>
            ))
        }
    </div>
</section>
