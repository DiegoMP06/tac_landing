---
import { cn } from "@/lib/utils";
import type { Brand } from "@/types";
import type { Card } from "@/types/pages";
import { useFeaturedImage } from "@/utils/image";

type Props = {
    card: Card;
    variant?: Brand;
};

const styles = {
    acu: {
        container:
            "bg-card/75 dark:bg-acu-card/40 border-acu-border/70 hover:border-acu-secondary/80 hover:shadow-xl hover:shadow-acu-secondary/15 before:bg-acu-secondary",
        iconContainer: "bg-acu-secondary/15 border-acu-secondary/30",
        icon: "text-acu-secondary",
        title: "text-acu-foreground group-hover:text-acu-secondary",
        content: "text-acu-foreground/75 dark:text-acu-muted-foreground",
    },
    acm: {
        container:
            "bg-card/75 dark:bg-acm-card/40 border-acm-border/70 hover:border-acm-secondary/80 hover:shadow-xl hover:shadow-acm-secondary/15 before:bg-acm-secondary",
        iconContainer: "bg-acm-secondary/15 border-acm-secondary/30",
        icon: "text-acm-secondary",
        title: "text-acm-foreground group-hover:text-acm-secondary",
        content: "text-acm-foreground/75 dark:text-acm-muted-foreground",
    },
    acc: {
        container:
            "bg-card/75 dark:bg-acc-card/40 border-acc-border/70 hover:border-acc-secondary/80 hover:shadow-xl hover:shadow-acc-secondary/15 before:bg-acc-secondary",
        iconContainer: "bg-acc-secondary/15 border-acc-secondary/30",
        icon: "text-acc-secondary",
        title: "text-acc-foreground group-hover:text-acc-secondary",
        content: "text-acc-foreground/75 dark:text-acc-muted-foreground",
    },
    default: {
        container:
            "bg-card/75 dark:bg-card/40 border-border/80 hover:border-secondary/80 hover:shadow-xl hover:shadow-secondary/15 before:bg-secondary",
        iconContainer: "bg-secondary/15 border-secondary/30",
        icon: "text-secondary",
        title: "text-foreground group-hover:text-secondary",
        content: "text-muted-foreground",
    },
};

const { card, variant = "default" } = Astro.props;
const currentStyles = styles[variant] || styles.default;
const icon = useFeaturedImage(card.icon)();
---

<div
    class={cn(
        "group h-full p-7 sm:p-8 rounded-2xl sm:rounded-3xl border backdrop-blur-xs transition-all duration-300 hover:-translate-y-1.5 relative overflow-hidden flex flex-col justify-between before:content-[''] before:absolute before:h-1 before:top-0 before:inset-x-0 before:transition-all before:duration-300 group-hover:before:h-1.5 shadow-xs",
        currentStyles.container,
    )}
>
    <div>
        <div
            class={cn(
                "mb-6 p-3.5 inline-block rounded-2xl border shadow-xs group-hover:scale-105 transition-transform duration-300",
                currentStyles.iconContainer,
            )}
        >
            <span
                class={cn(
                    "size-6 block [&>svg]:w-full [&>svg]:h-full",
                    currentStyles.icon,
                )}
                set:html={icon || ""}
            />
        </div>

        <h3
            class={cn(
                "text-xl sm:text-2xl font-heading font-bold mb-3.5 transition-colors duration-200 leading-snug",
                currentStyles.title,
            )}
        >
            {card.title}
        </h3>

        <p
            class={cn(
                "text-sm sm:text-base leading-relaxed font-normal",
                currentStyles.content,
            )}
        >
            {card.content}
        </p>
    </div>
</div>
