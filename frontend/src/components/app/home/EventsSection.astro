---
import { cn } from "@/lib/utils";
import type { Brand } from "@/types";
import type { HomePage } from "@/types/pages";
import { useLocalePath } from "@/utils/i18n";
import { ArrowRight } from "lucide-react";
import SectionHeading from "../SectionHeading.astro";
import SectionSubHeading from "../SectionSubHeading.astro";
import ListEventsFromSection from "./ListEventsFromSection.astro";
import { BrandsEnum } from "@/enums";

type Props = {
    section: HomePage["acf"]["events_section"];
    variant?: Brand;
};

const styles = {
    acu: {
        container: "bg-acu-card/30 border-acu-border/60",
        btn: "bg-acu-secondary/15 text-acu-secondary border-acu-secondary/30 hover:bg-acu-secondary hover:text-acu-secondary-foreground hover:shadow-lg hover:shadow-acu-secondary/20",
    },
    acm: {
        container: "bg-acm-card/30 border-acm-border/60",
        btn: "bg-acm-secondary/15 text-acm-secondary border-acm-secondary/30 hover:bg-acm-secondary hover:text-acm-secondary-foreground hover:shadow-lg hover:shadow-acm-secondary/20",
    },
    acc: {
        container: "bg-acc-card/30 border-acc-border/60",
        btn: "bg-acc-secondary/15 text-acc-secondary border-acc-secondary/30 hover:bg-acc-secondary hover:text-acc-secondary-foreground hover:shadow-lg hover:shadow-acc-secondary/20",
    },
    default: {
        container: "bg-muted/40 border-border/60",
        btn: "bg-secondary/15 text-secondary border-secondary/30 hover:bg-secondary hover:text-secondary-foreground hover:shadow-lg hover:shadow-secondary/20",
    },
};

const { section, variant = BrandsEnum.DEFAULT } = Astro.props;
const { locale } = useLocalePath(Astro.url);

const currentStyles = styles[variant] || styles.default;
const isDefault = variant === BrandsEnum.DEFAULT;
const eventsUrl = `/${locale}/${variant}/events`;
---

<section
    class={cn(
        `mt-20 md:mt-28 border-t border-b scroll-reveal relative overflow-hidden`,
        currentStyles.container,
    )}
>
    <div class="py-20 px-6 mx-auto max-w-6xl w-full">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 scroll-reveal"
        >
            <div class="max-w-2xl">
                <SectionHeading variant={variant}>
                    {section.title}
                </SectionHeading>

                <SectionSubHeading variant={variant} className="mt-2">
                    {section.subtitle}
                </SectionSubHeading>
            </div>

            {
                !isDefault && (
                    <a
                        href={eventsUrl}
                        class={cn(
                            "inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border text-sm font-bold transition-all duration-300 shrink-0 group self-start md:self-auto shadow-xs",
                            currentStyles.btn,
                        )}
                    >
                        <span>Ver todos los eventos</span>
                        <ArrowRight className="size-4 group-hover:translate-x-1 transition-transform duration-300" />
                    </a>
                )
            }
        </div>

        <ListEventsFromSection limit={section.limit} variant={variant} />
    </div>
</section>
