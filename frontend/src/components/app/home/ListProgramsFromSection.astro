---
import type { Brand } from "@/types";
import type { ListPrograms } from "@/types/programs";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { actions } from "astro:actions";
import ProgramItem from "../programs/ProgramItem.astro";
import { BrandsEnum } from "@/enums";

type Props = {
    variant?: Brand;
    limit: number;
};

const { variant = BrandsEnum.DEFAULT, limit } = Astro.props;
const { locale } = useLocalePath(Astro.url);

const { data, error } = await Astro.callAction(
    variant === BrandsEnum.DEFAULT
        ? actions.programs.getAndIndexProgramsWithoutBrand
        : actions.programs.getAndIndexAllPrograms,
    {
        brand: variant,
        locale,
        limit,
        featured: true,
    },
);

if (error) {
    return Astro.redirect("/404");
}
const t = useTranslations(locale);

const programs = data as ListPrograms;
---

{
    programs.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {programs.map((program) => (
                <ProgramItem program={program} brand={variant} />
            ))}
        </div>
    ) : (
        <div class="my-20">
            <p class="text-center text-muted-foreground">
                {t("AC.utils.programs.empty")}
            </p>
        </div>
    )
}
