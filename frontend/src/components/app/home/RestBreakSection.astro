---
import { cn } from "@/lib/utils";
import { useFeaturedImage } from "@/utils/image";
import SectionHeading from "../SectionHeading.astro";
import SectionSubHeading from "../SectionSubHeading.astro";
import type { HomePage } from "@/types/pages";
import type { Brand } from "@/types";
import type { FeaturedImageAtt } from "@/types/images";
import { Picture } from "astro:assets";

type Props = {
    section: HomePage["acf"]["rest_break"];
    variant?: Brand;
};

const styles = {
    acu: {
        background:
            "bg-acu-background/85 dark:bg-acu-background/75 border-acu-border/60",
        content: "text-acu-foreground/80 dark:text-acu-200",
        orb: "bg-acu-secondary/15",
    },
    acm: {
        background:
            "bg-acm-background/85 dark:bg-acm-background/75 border-acm-border/60",
        content: "text-acm-foreground/80 dark:text-acm-200",
        orb: "bg-acm-secondary/15",
    },
    acc: {
        background:
            "bg-acc-background/85 dark:bg-acc-background/75 border-acc-border/60",
        content: "text-acc-foreground/80 dark:text-acc-200",
        orb: "bg-acc-secondary/15",
    },
    default: {
        background: "bg-background/85 dark:bg-background/75 border-border/60",
        content: "text-muted-foreground",
        orb: "bg-secondary/15",
    },
};

const { section, variant = "default" } = Astro.props;
const image = useFeaturedImage(section.hero_image)() as FeaturedImageAtt;
const currentStyles = styles[variant] || styles.default;
---

<section class="relative overflow-hidden border-y border-border/80">
    {
        image && (
            <Picture
                src={image.url}
                width={image.width}
                height={image.height}
                alt={section.title}
                aria-hidden="true"
                formats={["avif", "webp"]}
                widths={[640, 960, 1280]}
                sizes="100vw"
                quality={50}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 z-10 size-full object-cover object-center transform scale-105 saturate-90 opacity-100"
            />
        )
    }
    <div
        class={cn(
            "absolute inset-0 z-20 backdrop-blur-md transition-colors duration-300 bg-linear-to-b from-background/60 via-background/40 to-background/60",
            currentStyles.background,
        )}
    >
    </div>

    <div
        class={cn(
            "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-96 md:size-125 rounded-full blur-3xl pointer-events-none z-20 animate-pulse-glow",
            currentStyles.orb,
        )}
    >
    </div>

    <div class="relative z-30">
        <div
            class="max-w-4xl mx-auto w-full px-6 py-24 lg:py-32 flex flex-col items-center text-center scroll-reveal"
        >
            <SectionHeading className="text-center" variant={variant}>
                {section.title}
            </SectionHeading>

            <SectionSubHeading
                variant={variant}
                className="text-center mt-3 mb-6"
            >
                {section.subtitle}
            </SectionSubHeading>

            <div
                class={cn(
                    "text-base sm:text-lg lg:text-xl leading-relaxed font-normal max-w-2xl mx-auto text-balance scroll-reveal delay-100",
                    currentStyles.content,
                )}
                set:html={section.content}
            />
        </div>
    </div>
</section>
