---
import type { Brand } from "@/types";
import type { ListPosts } from "@/types/blog";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { actions } from "astro:actions";
import PostItem from "./PostItem.astro";
import { Newspaper } from "lucide-react";

type Props = {
    variant?: Brand;
};

const { variant = "default" } = Astro.props;
const { locale } = useLocalePath(Astro.url);

const { data, error } = await Astro.callAction(
    actions.blog.getAndIndexAllPosts,
    {
        locale,
    },
);

if (error) {
    return Astro.redirect("/404");
}

const t = useTranslations(locale);
const posts = data as ListPosts;
---

{
    posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
            {posts.map((post) => (
                <div class="h-full">
                    <PostItem post={post} variant={variant} />
                </div>
            ))}
        </div>
    ) : (
        <div class="my-16 p-12 rounded-3xl border border-dashed border-border/80 text-center bg-card/40 max-w-md mx-auto">
            <div class="size-12 rounded-2xl bg-muted/60 flex items-center justify-center mx-auto mb-3 text-muted-foreground">
                <Newspaper className="size-6" />
            </div>
            <p class="text-sm font-medium text-muted-foreground">
                {t("AC.utils.blog.empty")}
            </p>
        </div>
    )
}
