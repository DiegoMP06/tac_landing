---
import ACUIcon from "@/assets/acu/icon.svg";
import ACCIcon from "@/assets/acc/icon.svg";
import ACMIcon from "@/assets/acm/icon.svg";
import DefaultIcon from "@/assets/icon.svg";
import type { Brand } from "@/types";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { cn } from "@/lib/utils";

type Props = {
    variant?: Brand;
};

const ICON_ATT = {
    acu: {
        acronym: "ACU",
        name: "The Americas Conference of Universities",
        altKey: "ACU.utils.icon.alt",
    },
    acc: {
        acronym: "ACC",
        name: "The Americas Chambers of Commerce",
        altKey: "ACC.utils.icon.alt",
    },
    acm: {
        acronym: "ACM",
        name: "The Americas Conference of Mayors",
        altKey: "ACM.utils.icon.alt",
    },
    default: {
        acronym: "AC",
        name: "The Americas Conference",
        altKey: "AC.utils.icon.alt",
    },
};

const { variant = "default" } = Astro.props;

const STYLES = {
    acu: {
        icon: ACUIcon,
        halo: "from-acu-secondary/20 via-acu-secondary/5 to-transparent border-acu-secondary/30 shadow-acu-secondary/15",
    },
    acc: {
        icon: ACCIcon,
        halo: "from-acc-secondary/20 via-acc-secondary/5 to-transparent border-acc-secondary/30 shadow-acc-secondary/15",
    },
    acm: {
        icon: ACMIcon,
        halo: "from-acm-secondary/20 via-acm-secondary/5 to-transparent border-acm-secondary/30 shadow-acm-secondary/15",
    },
    default: {
        icon: DefaultIcon,
        halo: "from-secondary/20 via-secondary/5 to-transparent border-secondary/30 shadow-secondary/15",
    },
};

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);
const currentStyles = STYLES[variant] || STYLES.default;
const currentIconAtt = ICON_ATT[variant] || ICON_ATT.default;
---

<div class="relative flex items-center justify-center">
    <!-- Ambient back glow -->
    <div
        class="absolute inset-0 rounded-full bg-linear-to-br from-secondary/15 via-primary/10 to-transparent blur-2xl scale-110 pointer-events-none"
    >
    </div>

    <!-- Glassmorphic Crest Frame -->
    <div
        class={cn(
            "relative p-4 sm:p-6 rounded-full bg-card/60 dark:bg-card/30 backdrop-blur-md border shadow-2xl transition-transform duration-500 hover:scale-105",
            currentStyles.halo,
        )}
    >
        <img
            src={currentStyles.icon.src}
            alt={t(currentIconAtt.altKey as never)}
            width={currentStyles.icon.width}
            height={currentStyles.icon.height}
            class="size-52 sm:size-64 lg:size-72 block aspect-square rounded-full drop-shadow-md"
            loading="eager"
        />
    </div>
</div>
