---
import { cn } from "@/lib/utils";
import type { Brand } from "@/types";
import type { FeaturedImageAtt } from "@/types/images";
import type { Page } from "@/types/pages";
import { useFeaturedImage } from "@/utils/image";
import { Picture } from "astro:assets";
import { Skeleton } from "@/components/ui/skeleton";
import { Quote } from "lucide-react";

type Props = {
    page: Page;
    variant?: Brand;
};

const STYLES = {
    acu: {
        title: "text-acu-secondary",
        subtitle: "text-acu-foreground dark:text-acu-50",
        content: "text-acu-foreground/80 dark:text-acu-muted-foreground",
        phrase: "bg-acu-secondary/10 dark:bg-acu-secondary/15 border-acu-secondary text-acu-foreground dark:text-acu-100",
        quoteIcon: "text-acu-secondary/40",
        imageHalo: "from-acu-secondary/20 via-acu-primary/10 to-transparent",
    },
    acc: {
        title: "text-acc-secondary",
        subtitle: "text-acc-foreground dark:text-acc-50",
        content: "text-acc-foreground/80 dark:text-acc-muted-foreground",
        phrase: "bg-acc-secondary/10 dark:bg-acc-secondary/15 border-acc-secondary text-acc-foreground dark:text-acc-100",
        quoteIcon: "text-acc-secondary/40",
        imageHalo: "from-acc-secondary/20 via-acc-primary/10 to-transparent",
    },
    acm: {
        title: "text-acm-secondary",
        subtitle: "text-acm-foreground dark:text-acm-50",
        content: "text-acm-foreground/80 dark:text-acm-muted-foreground",
        phrase: "bg-acm-secondary/10 dark:bg-acm-secondary/15 border-acm-secondary text-acm-foreground dark:text-acm-100",
        quoteIcon: "text-acm-secondary/40",
        imageHalo: "from-acm-secondary/20 via-acm-primary/10 to-transparent",
    },
    default: {
        title: "text-secondary",
        subtitle: "text-foreground dark:text-base-50",
        content: "text-muted-foreground",
        phrase: "bg-secondary/10 dark:bg-secondary/15 border-secondary text-foreground dark:text-base-100",
        quoteIcon: "text-secondary/40",
        imageHalo: "from-secondary/20 via-primary/10 to-transparent",
    },
};

const { page, variant = "default" } = Astro.props;
const image = useFeaturedImage(page.images)("large") as FeaturedImageAtt;
const currentStyles = STYLES[variant] || STYLES.default;
---

<section
    transition:animate="fade"
    transition:name="main-content"
    class="mx-auto max-w-6xl w-full my-20 md:my-28 px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center scroll-reveal"
>
    <div class="scroll-reveal-left space-y-5">
        <h2
            class={cn(
                "font-primary inline-flex items-center gap-3 uppercase text-xs sm:text-sm font-bold tracking-widest before:content-[''] before:w-6 before:h-0.5 before:bg-current before:rounded-full before:inline-block",
                currentStyles.title,
            )}
        >
            {page.acf.content.title}
        </h2>

        <h3
            class={cn(
                "font-heading font-extrabold text-3xl sm:text-4xl lg:text-[2.6rem] tracking-tight leading-[1.18] text-balance",
                currentStyles.subtitle,
            )}
        >
            {page.acf.content.subtitle}
        </h3>

        <div
            class={cn(
                "prose prose-base sm:prose-lg dark:prose-invert max-w-none leading-relaxed font-normal pt-1",
                currentStyles.content,
            )}
            set:html={page.content.rendered}
        />

        {page.acf.content.phrase && (
            <div
                class={cn(
                    "mt-6 p-6 sm:p-7 rounded-2xl border-l-4 italic shadow-xs backdrop-blur-xs transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 relative overflow-hidden",
                    currentStyles.phrase,
                )}
            >
                <Quote className={cn("size-8 absolute top-4 right-4 pointer-events-none", currentStyles.quoteIcon)} />
                <p class="font-medium text-base sm:text-lg leading-relaxed relative z-10">
                    "{page.acf.content.phrase}"
                </p>
            </div>
        )}
    </div>

    <div class="scroll-reveal-right delay-200">
        <div class="relative group">
            <!-- Ambient backdrop glow -->
            <div
                class={cn(
                    "absolute -inset-4 rounded-3xl bg-linear-to-br blur-2xl opacity-60 group-hover:opacity-90 transition-opacity duration-700 pointer-events-none",
                    currentStyles.imageHalo,
                )}
            >
            </div>

            <!-- Picture Frame -->
            <div
                class="relative rounded-3xl overflow-hidden border border-border/80 shadow-2xl bg-card/60 backdrop-blur-md p-2.5 transition-transform duration-500 hover:scale-[1.01]"
            >
                <div class="rounded-2xl overflow-hidden aspect-4/3 sm:aspect-square">
                    {
                        image ? (
                            <Picture
                                src={image.url}
                                width={image.width}
                                height={image.height}
                                alt={page.acf.content.subtitle || page.title.rendered}
                                formats={["avif", "webp"]}
                                widths={[400, 640, 800, 1024]}
                                sizes="(min-width: 1024px) 500px, calc(100vw - 68px)"
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                            />
                        ) : (
                            <Skeleton className="rounded-2xl h-full aspect-square" />
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</section>