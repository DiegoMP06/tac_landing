---
import { cn } from "@/lib/utils";
import { FeaturedImagesSizesEnum } from "@/enums/images";
import type { Brand } from "@/types";
import type { FeaturedImageAtt, FeaturedImages } from "@/types/images";
import { useFeaturedImage } from "@/utils/image";
import { Picture } from "astro:assets";

type Props = {
    title: string;
    subtitle: string;
    description: string;
    featured_image: FeaturedImages;
    variant?: Brand;
    badge?: string;
};

const STYLES = {
    acu: {
        badge: "bg-acu-secondary/15 text-acu-secondary border-acu-secondary/30",
        orb: "bg-acu-secondary/15",
    },
    acc: {
        badge: "bg-acc-secondary/15 text-acc-secondary border-acc-secondary/30",
        orb: "bg-acc-secondary/15",
    },
    acm: {
        badge: "bg-acm-secondary/15 text-acm-secondary border-acm-secondary/30",
        orb: "bg-acm-secondary/15",
    },
    default: {
        badge: "bg-secondary/15 text-secondary border-secondary/30",
        orb: "bg-secondary/15",
    },
};

const {
    title,
    subtitle,
    description,
    featured_image,
    variant = "default",
    badge,
} = Astro.props;
const image = useFeaturedImage(featured_image)(
    FeaturedImagesSizesEnum.full,
) as FeaturedImageAtt;
const currentStyles = STYLES[variant] || STYLES.default;
---

<section class="relative overflow-hidden border-b border-border/80">
    {
        image && (
            <Picture
                src={image.url}
                width={image.width}
                height={image.height}
                alt={title}
                aria-hidden="true"
                formats={["avif", "webp"]}
                widths={[640, 960, 1280, 1920]}
                sizes="100vw"
                quality={60}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 z-10 size-full object-cover object-center blur-[2px] scale-105"
            />
        )
    }
    <div
        class="absolute inset-0 z-20 backdrop-blur-xs transition-colors duration-300 bg-linear-to-b from-background/90 via-background/75 to-background"
    >
    </div>

    <!-- Ambient glowing light -->
    <div
        class={cn(
            "absolute top-0 right-1/4 size-96 sm:size-125 rounded-full blur-3xl pointer-events-none z-20 animate-pulse-glow",
            currentStyles.orb,
        )}
    >
    </div>

    <div class="relative z-30">
        <div
            class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-16 md:py-24 flex flex-col items-start"
        >
            <div class="max-w-3xl w-full space-y-4">
                <div class="flex items-center gap-3 flex-wrap">
                    <span
                        class={cn(
                            "inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider border backdrop-blur-xs shadow-xs",
                            currentStyles.badge,
                        )}
                    >
                        <span
                            class="size-1.5 rounded-full bg-current animate-pulse"
                        ></span>
                        {title}
                    </span>
                    {
                        badge && (
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-muted text-muted-foreground border border-border/60 shadow-xs">
                                {badge}
                            </span>
                        )
                    }
                </div>

                <h1
                    class="text-3xl sm:text-5xl md:text-6xl font-heading font-extrabold text-foreground tracking-tight leading-[1.12] text-balance"
                >
                    {subtitle}
                </h1>

                <p
                    class="text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed font-normal pt-1 text-balance max-w-2xl"
                >
                    {description}
                </p>
            </div>
        </div>
    </div>
</section>
