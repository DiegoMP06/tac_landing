---
import { cn } from "@/lib/utils";
import type { Brand } from "@/types";
import type { FeaturedImageAtt, FeaturedImages } from "@/types/images";
import { useFeaturedImage } from "@/utils/image";

type Props = {
    title: string;
    subtitle: string;
    description: string;
    featured_image: FeaturedImages;
    variant?: Brand;
    badge?: string;
};

const STYLES = {
    acu: {
        accent: "text-acu-secondary",
        badge: "bg-acu-secondary/20 text-acu-secondary border-acu-secondary/40",
        line: "bg-acu-secondary",
    },
    acc: {
        accent: "text-acc-secondary",
        badge: "bg-acc-secondary/20 text-acc-secondary border-acc-secondary/40",
        line: "bg-acc-secondary",
    },
    acm: {
        accent: "text-acm-secondary",
        badge: "bg-acm-secondary/20 text-acm-secondary border-acm-secondary/40",
        line: "bg-acm-secondary",
    },
    default: {
        accent: "text-secondary",
        badge: "bg-secondary/20 text-secondary border-secondary/40",
        line: "bg-secondary",
    },
};

const { title, subtitle, description, featured_image, variant = "default", badge } = Astro.props;
const image = useFeaturedImage(featured_image)() as FeaturedImageAtt;
const currentStyles = STYLES[variant] || STYLES.default;
---

<section class="relative overflow-hidden border-b border-border/80">
    <div
        class="absolute inset-0 z-10 bg-center bg-no-repeat bg-cover filter blur-[2px] scale-105 opacity-100"
        style={{
            backgroundImage: `url(${image?.url})`,
        }}
    >
    </div>
    <div class="absolute inset-0 z-20 bg-linear-to-b from-background/50 via-background/70 to-background">
    </div>

    <div class="absolute top-0 right-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none z-20"></div>

    <div class="relative z-30">
        <div
            class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-16 md:py-24 flex flex-col items-start"
        >
            <div class="max-w-3xl w-full space-y-4">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class={cn("inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider border backdrop-blur-md", currentStyles.badge)}>
                        <span class={cn("size-2 rounded-full animate-pulse", currentStyles.line)}></span>
                        {title}
                    </span>
                    {badge && (
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-muted text-muted-foreground border border-border/60">
                            {badge}
                        </span>
                    )}
                </div>

                <h1
                    class="text-3xl sm:text-5xl md:text-6xl font-heading font-black text-foreground tracking-tight leading-tight"
                >
                    {subtitle}
                </h1>

                <p class="text-lg md:text-xl text-muted-foreground leading-relaxed font-normal pt-2">
                    {description}
                </p>
            </div>
        </div>
    </div>
</section>
