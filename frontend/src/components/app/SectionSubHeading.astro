---
import { cn } from "@/lib/utils";
import type { Brand } from "@/types";

type Props = {
    variant?: Brand;
    className?: string;
} & astroHTML.JSX.HTMLAttributes;

const styles = {
    acu: "text-acu-foreground dark:text-acu-50",
    acm: "text-acm-foreground dark:text-acm-50",
    acc: "text-acc-foreground dark:text-acc-50",
    default: "text-foreground dark:text-base-50",
};

const { variant = "default", className = "", ...props } = Astro.props;

const currentStyles = styles[variant] || styles.default;
---

<h3
    class={cn(
        "font-heading font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] tracking-tight mb-6 sm:mb-8 leading-[1.18] text-balance",
        currentStyles,
        className,
    )}
    {...props}
>
    <slot />
</h3>
