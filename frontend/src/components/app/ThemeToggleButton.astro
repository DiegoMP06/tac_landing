---
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { Moon, Sun } from "lucide-react";

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);
---

<script is:inline>
    const getTheme = () => {
        if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
        ) {
            return localStorage.getItem("theme");
        }

        const match = document.cookie.match(new RegExp("(^| )theme=([^;]+)"));
        if (match) return match[2];

        return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    };

    const theme = getTheme();
    if (theme === "dark") {
        document.documentElement.classList.add("dark");
    } else {
        document.documentElement.classList.remove("dark");
    }
</script>

<button
    type="button"
    x-data="themeToggle"
    @click="toggle"
    class="p-2 rounded cursor-pointer hover:bg-accent border border-accent hover:shadow shadow-muted hover:border-muted-foreground transition-all ease-in-out duration-500"
>
    <span
        x-show="!dark"
        x-cloak
        aria-label={t("AC.header.theme.dark")}
        title={t("AC.header.theme.dark")}
    >
        <Moon className="size-6 text-muted-foreground" />
    </span>

    <span
        x-show="dark"
        x-cloak
        aria-label={t("AC.header.theme.light")}
        title={t("AC.header.theme.light")}
    >
        <Sun className="size-6 text-muted-foreground" />
    </span>
</button>

<style>
    [x-cloak] {
        display: none !important;
    }
</style>
