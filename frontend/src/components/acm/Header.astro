---
import Icon from "@/assets/acm/icon.svg";
import { useTranslations } from "@/utils/i18n";
import MainHeader from "../app/MainHeader.astro";
import MainMobileNav from "../app/MainMobileNav.astro";
import NavLink from "../app/NavLink.astro";
import ThemeToggleButton from "../app/ThemeToggleButton.astro";
import MobileNavLink from "../app/MobileNavLink.astro";

const { lang } = Astro.params;
const t = useTranslations(lang as never);
---

<MainHeader>
    <a
        class="cursor-pointer flex gap-2 items-center font-bold text-acm-foreground"
        href="/acm"
    >
        <img
            src={Icon.src}
            alt={t("ACM.utils.icon.alt")}
            width={Icon.width}
            height={Icon.height}
            class="size-10 aspect-square w-10 h-10 rounded-full"
            loading="eager"
        />
        <span class="hidden sm:block font-heading">
            The Americas Conference of Mayors
        </span>
    </a>

    <nav class="hidden lg:flex items-center gap-2">
        <NavLink href="/">
            {t("ACM.header.nav.home")}
        </NavLink>

        <NavLink href="/acm" variant="acm">
            {t("ACM.header.nav.ACM")}
        </NavLink>

        <NavLink href="/acm/about" variant="acm">
            {t("ACM.header.nav.about")}
        </NavLink>

        <NavLink href="/acm/programs" variant="acm">
            {t("ACM.header.nav.programs")}
        </NavLink>

        <NavLink href="/acm/events" variant="acm">
            {t("ACM.header.nav.events")}
        </NavLink>

        <NavLink href="/blog">
            {t("ACM.header.nav.blog")}
        </NavLink>

        <NavLink href="/contact">
            {t("ACM.header.nav.contact")}
        </NavLink>
    </nav>

    <nav class="flex gap-2">
        <MainMobileNav>
            <MobileNavLink href="/">
                {t("ACM.header.nav.home")}
            </MobileNavLink>

            <MobileNavLink href="/acm" variant="acm">
                {t("ACM.header.nav.ACM")}
            </MobileNavLink>

            <MobileNavLink href="/acm/about" variant="acm">
                {t("ACM.header.nav.about")}
            </MobileNavLink>

            <MobileNavLink href="/acm/programs" variant="acm">
                {t("ACM.header.nav.programs")}
            </MobileNavLink>

            <MobileNavLink href="/acm/events" variant="acm">
                {t("ACM.header.nav.events")}
            </MobileNavLink>

            <MobileNavLink href="/blog">
                {t("ACM.header.nav.blog")}
            </MobileNavLink>            

            <MobileNavLink href="/contact">
                {t("ACM.header.nav.contact")}
            </MobileNavLink>
        </MainMobileNav>

        <ThemeToggleButton />
    </nav>
</MainHeader>
