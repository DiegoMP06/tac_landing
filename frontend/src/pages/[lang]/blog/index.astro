---
import ListPostsSection from "@/components/app/blog/ListPostsSection.astro";
import { BrandsEnum } from "@/enums";
import { PageTypeEnum } from "@/enums/pages";
import AppLayout from "@/layouts/app/AppLayout.astro";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { buildBreadcrumbSchema } from "@/utils/jsonLd";
import { actions } from "astro:actions";

const entityId = "133";

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);

const { data: page, error } = await Astro.callAction(
    actions.pages.getAndIndexPage,
    {
        entityId,
        locale,
        brand: BrandsEnum.DEFAULT,
        type: PageTypeEnum.DEFAULT,
    },
);

if (error || !page) {
    return Astro.redirect("/404");
}

const breadcrumbs = buildBreadcrumbSchema([
    { name: t("AC.header.nav.home"), url: `/${locale}` },
    { name: t("AC.header.nav.blog"), url: `/${locale}/blog` },
]);
---

<AppLayout
    page={page}
    title={t("seo.pages.blog.title")}
    description={page.acf?.hero?.description || t("seo.pages.blog.description")}
    jsonLd={breadcrumbs}
>
    <ListPostsSection />
</AppLayout>
