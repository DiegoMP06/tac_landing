---
import HighlightItem from "@/components/app/extras/HighlightItem.astro";
import LocationMap from "@/components/app/leaflet/LocationMap.astro";
import BenefitItem from "@/components/app/programs/BenefitItem.astro";
import ExtrasLayout from "@/layouts/app/ExtrasLayout.astro";
import { cn } from "@/lib/utils";
import { BrandSchema } from "@/schemas";
import type { Program } from "@/types/programs";
import { formatDateToUser } from "@/utils/date";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { buildBreadcrumbSchema } from "@/utils/jsonLd";
import { actions } from "astro:actions";
import {
    Award,
    Clock,
    ExternalLink,
    Laptop,
    MapPin,
    Sparkles,
    Target,
} from "lucide-react";

const { slug = "", brand } = Astro.params;

const brandValidate = BrandSchema.safeParse(brand);

if (!brandValidate.success) {
    return Astro.redirect("/404");
}

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);

const { data, error } = await Astro.callAction(
    actions.programs.getAndIndexProgram,
    {
        slug,
        locale,
        brand: brandValidate.data,
    },
);

if (error || !data) {
    return Astro.redirect("/404");
}

const program = data as Program;

const DurationDisplays: Record<string, string> = {
    duration_per_months: `${program.acf.duration_per_months} ${program.acf.duration_per_months === 1 ? t("AC.utils.programs.month") : t("AC.utils.programs.months")}`,
    duration_per_weeks: `${program.acf.duration_per_weeks} ${program.acf.duration_per_weeks === 1 ? t("AC.utils.programs.week") : t("AC.utils.programs.weeks")}`,
    fixed_dates: `${formatDateToUser(program.acf.start_date || "", locale)} - ${formatDateToUser(program.acf.end_date || "", locale)}`,
};

const BRAND_THEMES = {
    acu: {
        btn: "bg-acu-secondary text-acu-secondary-foreground hover:bg-acu-secondary/90 shadow-md shadow-acu-secondary/20",
        badge: "bg-acu-secondary/15 text-acu-secondary border-acu-secondary/30",
        icon: "bg-acu-secondary/15 text-acu-secondary border-acu-secondary/30",
    },
    acm: {
        btn: "bg-acm-secondary text-acm-secondary-foreground hover:bg-acm-secondary/90 shadow-md shadow-acm-secondary/20",
        badge: "bg-acm-secondary/15 text-acm-secondary border-acm-secondary/30",
        icon: "bg-acm-secondary/15 text-acm-secondary border-acm-secondary/30",
    },
    acc: {
        btn: "bg-acc-secondary text-acc-secondary-foreground hover:bg-acc-secondary/90 shadow-md shadow-acc-secondary/20",
        badge: "bg-acc-secondary/15 text-acc-secondary border-acc-secondary/30",
        icon: "bg-acc-secondary/15 text-acc-secondary border-acc-secondary/30",
    },
    default: {
        btn: "bg-secondary text-secondary-foreground hover:bg-secondary/90 shadow-md shadow-secondary/20",
        badge: "bg-secondary/15 text-secondary border-secondary/30",
        icon: "bg-secondary/15 text-secondary border-secondary/30",
    },
};

const brandStyle = BRAND_THEMES[brandValidate.data] || BRAND_THEMES.default;

const jsonLd = [
    buildBreadcrumbSchema([
        { name: t("AC.header.nav.home"), url: `/${locale}` },
        { name: brandValidate.data.toUpperCase(), url: `/${locale}/${brandValidate.data}` },
        { name: t("seo.pages.programs.title"), url: `/${locale}/${brandValidate.data}/programs` },
        { name: program.title.rendered, url: Astro.url.href },
    ]),
];
---

<ExtrasLayout
    {...{
        title: program.title.rendered,
        subtitle: program.acf.subtitle,
        description: program.acf.description,
        featured_image: program.images,
        cta: program.acf.cta,
        variant: brandValidate.data,
        jsonLd,
    }}
>
    <div class="my-12 md:my-20 mx-auto max-w-7xl w-full px-4 sm:px-6">
        <div
            class="grid grid-cols-1 lg:grid-cols-[1fr_360px] xl:grid-cols-[1fr_400px] gap-10 lg:gap-14 items-start"
        >
            <!-- Left Column: Main Content, Benefits & Highlights -->
            <div class="space-y-16 min-w-0">
                <!-- Main HTML Content -->
                <article
                    class="prose prose-base sm:prose-lg dark:prose-invert max-w-none text-foreground/90 leading-relaxed font-normal"
                >
                    <div set:html={program.content.rendered} />
                </article>

                <!-- Benefits Section -->
                <section class="space-y-6 pt-8 border-t border-border/80">
                    <div class="flex items-center justify-between gap-4 flex-wrap">
                        <div class="flex items-center gap-3.5">
                            <div
                                class={cn(
                                    "size-11 rounded-2xl flex items-center justify-center shrink-0 border shadow-xs",
                                    brandStyle.icon,
                                )}
                            >
                                <Award className="size-5" />
                            </div>
                            <div>
                                <h3
                                    class="font-heading font-extrabold text-2xl sm:text-3xl text-foreground tracking-tight"
                                >
                                    {t("AC.pages.programs.benefits.title")}
                                </h3>
                                <p class="text-xs sm:text-sm text-muted-foreground">
                                    {t("AC.pages.programs.benefits.subtitle")}
                                </p>
                            </div>
                        </div>

                        {
                            program.acf.benefits.length > 0 && (
                                <span
                                    class={cn(
                                        "px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider border shadow-xs",
                                        brandStyle.badge,
                                    )}
                                >
                                    {program.acf.benefits.length}{" "}
                                    {program.acf.benefits.length === 1
                                        ? t("AC.pages.programs.benefits.singular")
                                        : t("AC.pages.programs.benefits.plural")}
                                </span>
                            )
                        }
                    </div>

                    {
                        program.acf.benefits.length > 0 ? (
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 items-stretch">
                                {program.acf.benefits.map((benefit) => (
                                    <div class="h-full">
                                        <BenefitItem benefit={benefit} />
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <div class="p-12 rounded-3xl border border-dashed border-border/80 text-center bg-card/40">
                                <Award className="size-10 text-muted-foreground/40 mx-auto mb-3" />
                                <p class="text-muted-foreground text-sm font-medium">
                                    {t("AC.pages.programs.benefits.empty")}
                                </p>
                            </div>
                        )
                    }
                </section>

                <!-- Highlights Section -->
                <section class="space-y-6 pt-8 border-t border-border/80">
                    <div class="flex items-center gap-3.5">
                        <div
                            class={cn(
                                "size-11 rounded-2xl flex items-center justify-center shrink-0 border shadow-xs",
                                brandStyle.icon,
                            )}
                        >
                            <Sparkles className="size-5" />
                        </div>
                        <div>
                            <h3
                                class="font-heading font-extrabold text-2xl sm:text-3xl text-foreground tracking-tight"
                            >
                                {t("AC.pages.programs.highlights.title")}
                            </h3>
                            <p class="text-xs sm:text-sm text-muted-foreground">
                                {t("AC.pages.programs.highlights.subtitle")}
                            </p>
                        </div>
                    </div>

                    {
                        program.acf.highlights.length > 0 ? (
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 items-stretch">
                                {program.acf.highlights.map((highlight) => (
                                    <div class="h-full">
                                        <HighlightItem highlight={highlight} />
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <div class="p-12 rounded-3xl border border-dashed border-border/80 text-center bg-card/40">
                                <Sparkles className="size-10 text-muted-foreground/40 mx-auto mb-3" />
                                <p class="text-muted-foreground text-sm font-medium">
                                    {t("AC.pages.programs.highlights.empty")}
                                </p>
                            </div>
                        )
                    }
                </section>
            </div>

            <!-- Right Column: Glassmorphic Sticky Sidebar -->
            <aside class="sticky top-28 space-y-6">
                <div
                    class="rounded-3xl border border-border/80 bg-card/85 dark:bg-card/50 backdrop-blur-xl shadow-xl overflow-hidden p-6 sm:p-8 space-y-6"
                >
                    <h3
                        class="font-heading font-bold text-xl text-foreground pb-4 border-b border-border/60 flex items-center gap-2"
                    >
                        <span>{t("AC.pages.programs.info")}</span>
                    </h3>

                    <div class="space-y-5">
                        <!-- Duration -->
                        <div class="flex items-start gap-3.5">
                            <div
                                class={cn(
                                    "size-9 rounded-xl flex items-center justify-center shrink-0 mt-0.5 border shadow-xs",
                                    brandStyle.icon,
                                )}
                            >
                                <Clock className="size-4" />
                            </div>
                            <div>
                                <p
                                    class="text-xs font-bold uppercase tracking-wider text-muted-foreground"
                                >
                                    {t("AC.pages.programs.duration")}
                                </p>
                                <p
                                    class="text-sm font-bold text-foreground mt-0.5 leading-snug"
                                >
                                    {
                                        DurationDisplays[
                                            program.acf.duration_type
                                        ]
                                    }
                                </p>
                            </div>
                        </div>

                        <!-- Modality -->
                        <div class="flex items-start gap-3.5">
                            <div
                                class={cn(
                                    "size-9 rounded-xl flex items-center justify-center shrink-0 mt-0.5 border shadow-xs",
                                    brandStyle.icon,
                                )}
                            >
                                <Laptop className="size-4" />
                            </div>
                            <div>
                                <p
                                    class="text-xs font-bold uppercase tracking-wider text-muted-foreground"
                                >
                                    {t("AC.pages.programs.mode")}
                                </p>
                                <div class="mt-1">
                                    <span
                                        class={cn(
                                            "inline-flex items-center px-3 py-0.5 rounded-full text-xs font-bold border shadow-xs",
                                            brandStyle.badge,
                                        )}
                                    >
                                        {
                                            t(
                                                `AC.utils.modalities.${program.acf.modality}`,
                                            )
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Target Audience -->
                        {
                            program.acf.target_audience && (
                                <div class="flex items-start gap-3.5">
                                    <div
                                        class={cn(
                                            "size-9 rounded-xl flex items-center justify-center shrink-0 mt-0.5 border shadow-xs",
                                            brandStyle.icon,
                                        )}
                                    >
                                        <Target className="size-4" />
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
                                            {t("AC.pages.programs.target")}
                                        </p>
                                        <p class="text-sm font-medium text-foreground mt-0.5 leading-snug">
                                            {program.acf.target_audience}
                                        </p>
                                    </div>
                                </div>
                            )
                        }

                        <!-- Online Link (If available) -->
                        {
                            program.acf.online_link && (
                                <div class="pt-2">
                                    <a
                                        href={program.acf.online_link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class={cn(
                                            "min-h-[44px] w-full py-3 px-4 rounded-xl font-bold text-sm uppercase tracking-wide transition-all duration-300 flex items-center justify-center gap-2 group cursor-pointer hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring",
                                            brandStyle.btn,
                                        )}
                                    >
                                        <span>
                                            {t("AC.pages.programs.onlineLink")}
                                        </span>
                                        <ExternalLink className="size-4 group-hover:translate-x-0.5 transition-transform" />
                                    </a>
                                </div>
                            )
                        }

                        <!-- Location -->
                        {
                            program.acf.location?.address && (
                                <div class="flex items-start gap-3.5 pt-3 border-t border-border/60">
                                    <div
                                        class={cn(
                                            "size-9 rounded-xl flex items-center justify-center shrink-0 mt-0.5 border shadow-xs",
                                            brandStyle.icon,
                                        )}
                                    >
                                        <MapPin className="size-4" />
                                    </div>
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
                                            {t("AC.pages.programs.location")}
                                        </p>
                                        <p class="text-sm font-medium text-foreground mt-0.5 leading-snug">
                                            {program.acf.location.address}
                                        </p>
                                    </div>
                                </div>
                            )
                        }
                    </div>

                    <!-- Location Map -->
                    {
                        program.acf.location && (
                            <div class="rounded-2xl overflow-hidden border border-border/60 shadow-xs">
                                <LocationMap location={program.acf.location} />
                            </div>
                        )
                    }
                </div>
            </aside>
        </div>
    </div>
</ExtrasLayout>
