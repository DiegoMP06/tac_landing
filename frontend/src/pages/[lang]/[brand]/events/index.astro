---
import ListEventsSection from "@/components/app/events/ListEventsSection.astro";
import { PageTypeEnum } from "@/enums/pages";
import AppLayout from "@/layouts/app/AppLayout.astro";
import { BrandSchema } from "@/schemas";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { buildBreadcrumbSchema } from "@/utils/jsonLd";
import { actions } from "astro:actions";

const idDict = {
    acu: "60",
    acc: "57",
    acm: "59",
};

const { brand } = Astro.params;

const brandValidate = BrandSchema.safeParse(brand);

if (!brandValidate.success) {
    return Astro.redirect("/404");
}

const entityId = idDict[brandValidate.data];

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);

const { data: page, error } = await Astro.callAction(
    actions.pages.getAndIndexPage,
    {
        entityId,
        locale,
        brand: brandValidate.data,
        type: PageTypeEnum.DEFAULT,
    },
);

if (error) {
    return Astro.redirect("/404");
}

const breadcrumbs = buildBreadcrumbSchema([
    { name: t("AC.header.nav.home"), url: `/${locale}` },
    { name: brandValidate.data.toUpperCase(), url: `/${locale}/${brandValidate.data}` },
    { name: page.title.rendered, url: `/${locale}/${brandValidate.data}/events` },
]);
---

<AppLayout
    page={page}
    variant={brandValidate.data}
    description={page.acf?.hero?.description || t("seo.pages.events.description")}
    jsonLd={breadcrumbs}
>
    <ListEventsSection variant={brandValidate.data} />
</AppLayout>
