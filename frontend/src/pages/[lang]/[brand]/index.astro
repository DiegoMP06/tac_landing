---
import HomePage from "@/components/app/fragments/HomePage.astro";
import CountDownSection from "@/components/app/home/CountDownSection.astro";
import { PageTypeEnum } from "@/enums/pages";
import AppLayout from "@/layouts/app/AppLayout.astro";
import { BrandSchema } from "@/schemas";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { buildBreadcrumbSchema } from "@/utils/jsonLd";
import { actions } from "astro:actions";

const idDict = {
    acu: "43",
    acc: "41",
    acm: "41",
};

const { brand } = Astro.params;

const brandValidate = BrandSchema.safeParse(brand);

if (!brandValidate.success) {
    return Astro.redirect("/404");
}

const entityId = idDict[brandValidate.data];

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);

const { data: page, error } = await Astro.callAction(
    actions.pages.getAndIndexPage,
    {
        entityId,
        locale,
        brand: brandValidate.data,
        type: PageTypeEnum.HOME,
    },
);

if (error || !page) {
    return Astro.redirect("/404");
}

const {
    acf: { count_down },
} = page;

const breadcrumbs = buildBreadcrumbSchema([
    { name: t("AC.header.nav.home"), url: `/${locale}` },
    { name: page.title.rendered, url: `/${locale}/${brandValidate.data}` },
]);

const brandTitle = t(`seo.brands.${brandValidate.data}.title` as never);
const brandDescription =
    page.acf?.hero?.description ||
    t(`seo.brands.${brandValidate.data}.description` as never);
---

<AppLayout
    page={page}
    variant={brandValidate.data}
    title={brandTitle}
    description={brandDescription}
    jsonLd={breadcrumbs}
>
    {
        count_down?.enable && (
            <CountDownSection
                slot="count_down"
                section={count_down}
                variant={brandValidate.data}
            />
        )
    }
    <HomePage page={page} variant={brandValidate.data} />
</AppLayout>
