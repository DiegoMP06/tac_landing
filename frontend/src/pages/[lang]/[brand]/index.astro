---
import HomePage from "@/components/app/fragments/HomePage.astro";
import CountDownSection from "@/components/app/home/CountDownSection.astro";
import { PageTypeEnum } from "@/enums/pages";
import AppLayout from "@/layouts/app/AppLayout.astro";
import { BrandSchema } from "@/schemas";
import { useLocalePath } from "@/utils/i18n";
import { actions } from "astro:actions";

const idDict = {
    acu: "43",
    acc: "41",
    acm: "41",
};

const { brand } = Astro.params;

const brandValidate = BrandSchema.safeParse(brand);

if (!brandValidate.success) {
    return Astro.redirect("/404");
}

const entityId = idDict[brandValidate.data];

const { locale } = useLocalePath(Astro.url);

const { data: page, error } = await Astro.callAction(
    actions.pages.getAndIndexPage,
    {
        entityId,
        locale,
        brand: brandValidate.data,
        type: PageTypeEnum.HOME,
    },
);

if (error || !page) {
    return Astro.redirect("/404");
}

const {
    acf: { count_down },
} = page;
---

<AppLayout page={page} variant={brandValidate.data}>
    {
        count_down?.enable && (
            <CountDownSection
                slot="count_down"
                section={count_down}
                variant={brandValidate.data}
            />
        )
    }
    <HomePage page={page} variant={brandValidate.data} />
</AppLayout>
