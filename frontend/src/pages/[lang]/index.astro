---
import HomePage from "@/components/app/fragments/HomePage.astro";
import CountDownSection from "@/components/app/home/CountDownSection.astro";
import { BrandsEnum } from "@/enums";
import { PageTypeEnum } from "@/enums/pages";
import AppLayout from "@/layouts/app/AppLayout.astro";
import { useLocalePath, useTranslations } from "@/utils/i18n";
import { buildOrganizationSchema, buildWebSiteSchema } from "@/utils/jsonLd";
import { actions } from "astro:actions";

const entityId = "32";

const { locale } = useLocalePath(Astro.url);
const t = useTranslations(locale);

const { data: page, error } = await Astro.callAction(
    actions.pages.getAndIndexPage,
    {
        entityId,
        locale,
        brand: BrandsEnum.DEFAULT,
        type: PageTypeEnum.HOME,
    },
);

if (error || !page) {
    return Astro.redirect("/404");
}

const {
    acf: { count_down },
} = page;

const jsonLd = [
    buildOrganizationSchema(t("seo.siteName"), t("seo.siteDescription")),
    buildWebSiteSchema(t("seo.siteName"), locale),
];
---

<AppLayout
    page={page}
    title={t("seo.pages.home.title")}
    description={page.acf?.hero?.description || t("seo.pages.home.description")}
    jsonLd={jsonLd}
>
    {
        count_down?.enable && (
            <CountDownSection
                slot="count_down"
                section={count_down}
                variant={BrandsEnum.DEFAULT}
            />
        )
    }

    <HomePage page={page} variant={BrandsEnum.DEFAULT} />
</AppLayout>
