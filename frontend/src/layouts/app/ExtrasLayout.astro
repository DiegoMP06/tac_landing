---
import ACFooter from "@/components/ac/Footer.astro";
import ACHeader from "@/components/ac/Header.astro";
import ACUFooter from "@/components/acu/Footer.astro";
import ACUHeader from "@/components/acu/Header.astro";
import ACCFooter from "@/components/acc/Footer.astro";
import ACCHeader from "@/components/acc/Header.astro";
import ACMFooter from "@/components/acm/Footer.astro";
import ACMHeader from "@/components/acm/Header.astro";
import CTASection from "@/components/app/extras/CTASection.astro";
import ExtrasHero from "@/components/app/extras/ExtrasHero.astro";
import { BrandsEnum } from "@/enums";
import Layout from "@/layouts/Layout.astro";
import type { Brand, CTAType } from "@/types";
import type { FeaturedImages } from "@/types/images";

type Props = {
    title: string;
    description: string;
    subtitle: string;
    featured_image: FeaturedImages;
    cta?: CTAType;
    variant?: Brand;
    badge?: string;
    type?: "website" | "article";
    publishedTime?: string;
    modifiedTime?: string;
    noindex?: boolean;
    canonical?: string;
    jsonLd?: Record<string, any> | Array<Record<string, any>>;
};

const {
    title,
    description,
    subtitle,
    featured_image,
    cta,
    variant = BrandsEnum.DEFAULT,
    badge,
    type = "website",
    publishedTime,
    modifiedTime,
    noindex,
    canonical,
    jsonLd,
} = Astro.props;

const Titles = {
    [BrandsEnum.DEFAULT]: "The Americas Conference",
    [BrandsEnum.ACM]: "The Americas Conference of Mayors",
    [BrandsEnum.ACC]: "The Americas Chambers of Commerce",
    [BrandsEnum.ACU]: "The Americas Conference of Universities",
};

const pageTitle = subtitle ? `${Titles[variant]} | ${subtitle}` : `${Titles[variant]} | ${title}`;
const imageUrl = featured_image && !featured_image.is_svg
    ? (featured_image.sizes?.large?.url || featured_image.sizes?.full?.url)
    : undefined;
---

<Layout
    title={pageTitle}
    description={description}
    image={imageUrl}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    noindex={noindex}
    canonical={canonical}
    variant={variant}
    jsonLd={jsonLd}
>
    {
        (() => {
            switch (variant) {
                case BrandsEnum.ACM:
                    return <ACMHeader />;
                case BrandsEnum.ACC:
                    return <ACCHeader />;
                case BrandsEnum.ACU:
                    return <ACUHeader />;
                default:
                    return <ACHeader />;
            }
        })()
    }

    <main class="flex-1">
        <ExtrasHero
            {...{
                title,
                description,
                subtitle,
                featured_image,
                variant,
                badge,
            }}
        />

        <slot />

        {cta && <CTASection cta={cta} variant={variant} />}
    </main>

    {
        (() => {
            switch (variant) {
                case BrandsEnum.ACM:
                    return <ACMFooter />;
                case BrandsEnum.ACC:
                    return <ACCFooter />;
                case BrandsEnum.ACU:
                    return <ACUFooter />;
                default:
                    return <ACFooter />;
            }
        })()
    }
</Layout>
