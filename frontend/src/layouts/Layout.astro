---
import "../styles/global.css";

import dmSansLatin from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import playfairLatin from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";

import LoadChatbotData from "@/components/app/chatbot/LoadChatbotData.astro";
import Favicon from "@/components/app/Favicon.astro";
import GetDefaultTheme from "@/components/app/GetDefaultTheme.astro";
import ToasterContainer from "@/components/app/ToasterContainer";
import SEO from "@/components/SEO.astro";
import JsonLd from "@/components/JsonLd.astro";
import type { Brand } from "@/types";
import { useLocalePath } from "@/utils/i18n";
import { ClientRouter } from "astro:transitions";

type Props = {
    title: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    type?: "website" | "article";
    noindex?: boolean;
    canonical?: string;
    publishedTime?: string;
    modifiedTime?: string;
    variant?: Brand;
    jsonLd?: Record<string, any> | Array<Record<string, any>>;
};

const {
    title,
    description,
    image,
    imageAlt,
    type = "website",
    noindex = false,
    canonical,
    publishedTime,
    modifiedTime,
    variant = "default",
    jsonLd,
} = Astro.props;

const theme = Astro.cookies.get("theme")?.value;
const { locale } = useLocalePath(Astro.url);
---

<!doctype html>
<html lang={locale} class={theme === "dark" ? "dark" : ""}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <link
            rel="preload"
            href={playfairLatin}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <link
            rel="preload"
            href={dmSansLatin}
            as="font"
            type="font/woff2"
            crossorigin
        />

        <SEO
            title={title}
            description={description}
            image={image}
            imageAlt={imageAlt}
            type={type}
            noindex={noindex}
            canonical={canonical}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            variant={variant}
        />

        <Favicon variant={variant} />

        <meta name="generator" content={Astro.generator} />

        <ClientRouter />

        {jsonLd && <JsonLd data={jsonLd} />}

        <GetDefaultTheme />
    </head>
    <body
        class="bg-background min-h-screen flex flex-col font-sans antialiased"
    >
        <slot />

        <LoadChatbotData />

        <ToasterContainer client:load transition:persist="toaster-container" />

        <script is:inline>
            (function () {
                const initScrollObserver = () => {
                    const observer = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("is-visible");
                                }
                            });
                        },
                        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
                    );

                    document
                        .querySelectorAll(
                            ".scroll-reveal, .scroll-reveal-left, .scroll-reveal-right, .scroll-reveal-scale, .animate-fade-in-up",
                        )
                        .forEach((el) => {
                            observer.observe(el);
                        });
                };

                if (document.readyState === "loading") {
                    document.addEventListener(
                        "DOMContentLoaded",
                        initScrollObserver,
                    );
                } else {
                    initScrollObserver();
                }
                document.addEventListener(
                    "astro:page-load",
                    initScrollObserver,
                );
            })();
        </script>
    </body>
</html>
